---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

const { title, description, pubDate, updatedDate, sketchScript } = Astro.props;

---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script>
			import p5 from 'p5';
			const sketches = import.meta.glob<{default: (width: number, height: number) => (instance: p5) => void;}>("/src/script/sketches/*.js");
            const container = document.getElementById("sketch-container");
            if (container)
            {
                const sketchLoader = sketches[`/src/script/sketches/${container.dataset.sketch}.js`];
				const { default: sketch } = await sketchLoader();
                new p5(sketch(720, 600), container);
            }

        </script>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			article {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}

            #sketch-container {
                width: 100%;
            }
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
                <div class="title">
                    <div class="date">
                        <FormattedDate date={pubDate} />
                        {
                            updatedDate && (
                                <div class="last-updated-on">
                                    Last updated on <FormattedDate date={updatedDate} />
                                </div>
                            )
                        }
                    </div>
                    <h1>{title}</h1>
                    <hr />
                </div>
				<div id="sketch-container" data-sketch={sketchScript}></div>
                <slot />
			</article>
		</main>
		<Footer />
	</body>
</html>
